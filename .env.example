# Copy this file to .env and add your own key. Never commit a real key.
# The app also accepts the key via --dart-define:
#   flutter run --dart-define=OPENAI_API_KEY=sk-your-key-here
#   flutter run --dart-define=OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
